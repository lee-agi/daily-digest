# Daily Digest Environment Variables
# Copy to .env and fill in your values

# GitHub (free PAT for higher rate limits)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Reddit (create app at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret

# RSS Worker
RSS_API_KEY=your_rss_worker_api_key

# Azure OpenAI (for LLM summarization)
# These are usually set in ~/.bashrc already
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_BASE_URL=
# AZURE_OPENAI_API_VERSION=2025-03-01-preview

# X/Twitter (TwitterAPI.io or twikit cookies)
TWITTER_API_IO_KEY=
X_AUTH_TOKEN=
X_CT0=

# Product Hunt
PRODUCTHUNT_API_TOKEN=

# YouTube Data API v3 (required since RSS deprecated)
YOUTUBE_DATA_API_KEY=
